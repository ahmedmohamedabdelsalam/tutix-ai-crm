generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                String         @id @default(cuid())
  name              String
  ownerName         String?
  ownerPhone        String?
  phone             String?
  waPhoneId         String?
  waToken           String?
  packages          String?
  aiPrompt          String?
  apiKey            String?        @unique
  emailDomain       String?
  industry          Industry       @default(HAJJ_UMRAH)
  subscriptionPlan  String         @default("Basic")
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  conversations     Conversation[]
  leads             Lead[]
  users             User[]
  tasks             Task[]
  permanentCustomers PermanentCustomer[]
  payments          Payment[]
  agentInsights     AgentInsight[]
  faqs              CompanyFAQ[]
  notifications     SystemNotification[]
  dailyTasks        DailyTask[]
  aiConfig          CompanyAIConfig?
  branches          Branch[]
  attendanceRecords AttendanceRecord[]
  specialtyWeights  UserSpecialtyWeight[]
  activityLogs      ActivityLog[]
  savedReplies      SavedReply[]
  offeringTypes     OfferingType[]
  offerings         Offering[]
}

model CompanyAIConfig {
  id               String   @id @default(cuid())
  companyId        String   @unique
  industryType     String   // "HAJJ_UMRAH" | "EDUCATION" | etc.

  // Structured catalog data (replaces hardcoded .ts files)
  // Shape: { umrahPrograms: UmrahProgram[], hajjPrograms: HajjProgram[], hotelBookingLinks: Record<string,string> }
  catalog          Json

  // Company-specific tone / personality notes (supplements base-personality.ts)
  salesPersonality String   @db.Text

  // Industry-specific structured data: branches, hotel details, Hijri dates, FAQ text, etc.
  industryData     Json?

  isActive         Boolean  @default(false)
  templates        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  email         String   @unique
  password      String
  role                UserRole @default(AGENT)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  manualLeadWeight    Int      @default(0)
  aiLeadWeight        Int      @default(0)
  company       Company  @relation(fields: [companyId], references: [id])
  assignedLeads Lead[]   @relation("LeadAssignment")
  tasks         Task[]
  callLogs          CallLog[]
  attendanceRecords AttendanceRecord[]
  specialtyWeights  UserSpecialtyWeight[]

  @@index([companyId])
}

model Lead {
  id            String         @id @default(cuid())
  companyId     String
  name          String?
  /// NULLABLE since Phase 3a — a lead created from a BSUID-only conversation has no
  /// phone number. The manual lead form still REQUIRES one: a BSUID cannot be
  /// invented for an outbound-initiated conversation.
  phone         String?
  packageType   String?
  groupSize     Int?
  budget        String?
  travelDate    String?
  notes         String?
  score                Int            @default(0)
  isHot                Boolean        @default(false)
  manualReviewRequired Boolean        @default(false)
  manualFields  String?
  status        LeadStatus     @default(NEW)
  source        String         @default("whatsapp")
  platform      String?
  serviceType   String?
  roomType      String?
  level         String?
  governorate   String?
  recordDate    DateTime?
  totalMessages Int?
  hajjMessages  Int?
  umrahMessages Int?
  otherMessages Int?
  assignedAgent String?
  executionNotes String?
  extraNotes    String?
  companionNote String?
  referralData  Json?
  customerType  String?
  assignedTo    String?
  assignedAt    DateTime?
  tripDepartureDate  DateTime?
  tripProgramName    String?
  branchName         String?
  contactLink         String?
  manualFollowUpAt    DateTime?
  manualFollowUpNote  String?
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  tasks         Task[]
  callLogs      CallLog[]
  payments      Payment[]
  company       Company        @relation(fields: [companyId], references: [id])
  assignedUser  User?          @relation("LeadAssignment", fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([phone])
  @@index([assignedTo])
}

model Conversation {
  id                   String         @id @default(cuid())
  companyId            String
  leadId               String?
  /// NULLABLE since Phase 3a. Meta's usernames rollout omits `from`/`wa_id` once a
  /// user adopts a username, so a conversation may be identified ONLY by waUserId.
  /// Resolution order is waUserId first, then phone. Every read must handle null.
  phone                String?
  /// Business-scoped user ID from Meta (contacts[0].user_id), format "<CC>.<alnum>".
  /// Nullable and additive: Phase 1 CAPTURES it so an existing phone-keyed row can be
  /// linked to the same person's BSUID during the window in which Meta sends BOTH.
  /// Identity resolution still runs on phone — that switch is Phase 3, together with
  /// making `phone` optional.
  waUserId             String?
  /// WhatsApp display name from contacts[0].profile.name, captured on every inbound.
  /// DISPLAY ONLY — never an identifier, and never trusted as a fact about the
  /// person: the customer sets it themselves and can change it at any time.
  ///
  /// It exists because a BSUID-only conversation has no phone and a fresh, nameless
  /// Lead, so the inbox would render an anonymous row that sales cannot tell apart
  /// from any other. This is the only human-readable identity such a customer has.
  profileName             String?
  status               ConvStatus     @default(AI_HANDLING)
  agentMode            String         @default("HUMAN")
  assignedSalesId      String?
  agentNotes           String?
  followUpScheduledAt  DateTime?
  followUpStatus       FollowUpStatus @default(NONE)
  handoffMessageSent   Boolean        @default(false)
  dropOffAnalyzed      Boolean        @default(false)
  needsSalesContact    Boolean        @default(false)
  salesAlertReason     String?
  bookingStage         String         @default("NONE")
  handledByUserId      String?
  handledByName        String?
  handledAt            DateTime?
  markedUnread         Boolean        @default(false)
  isPinned             Boolean        @default(false)
  isTest               Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  company    Company    @relation(fields: [companyId], references: [id])
  lead       Lead?      @relation(fields: [leadId], references: [id])
  messages   Message[]

  @@index([companyId])
  @@index([phone, companyId])
  @@unique([companyId, waUserId])
  @@index([followUpStatus])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  senderUserId   String?
  senderName     String?
  mediaUrl       String?
  mediaType      String?
  whatsappMsgId  String?
  replyToId      String?
  /// Delivery status from Meta's status webhook. FORWARD-ONLY: see status-webhook.ts.
  /// A plain String, not an enum, so a status Meta adds later (e.g. 'deleted') is
  /// stored and logged rather than rejected by the client and lost.
  status         String?
  statusAt       DateTime?
  /// Why Meta could not deliver it. Only set when status = 'failed' — that is a
  /// customer who never received the message, which today we would never know.
  failureReason  String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  // Prevention, not remediation: the audit found 0 duplicate wamids in 16,362 rows.
  // Meta can redeliver a webhook, and the in-memory dedup map is wiped by every
  // deploy — this makes the database the arbiter instead of process memory, and
  // also covers a redelivery landing on a different conversation.
  // NULLs stay unconstrained: PostgreSQL treats NULLs as distinct in a unique
  // index, so the 6,561 unstamped rows are unaffected. (Prisma cannot express a
  // partial index; this is equivalent and survives `prisma db push`.)
  @@unique([whatsappMsgId])
}

enum Industry {
  HAJJ_UMRAH
  HEALTHCARE
  REAL_ESTATE
  EDUCATION
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  SALES_MANAGER
  AGENT
  ACCOUNTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  PENDING_PAYMENT
  WON
  HOT
  CONVERTED
  COLD
  LOST
}

enum ConvStatus {
  AI_HANDLING
  NEEDS_HUMAN
  ASSIGNED
  CLOSED
}

enum FollowUpStatus {
  NONE
  SCHEDULED
  SENT
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ServiceSpecialty {
  HAJJ
  UMRAH
  FLIGHTS
  OTHER
}

model Task {
  id          String   @id @default(cuid())
  companyId   String
  leadId      String?
  assignedTo  String
  title       String
  notes       String?
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])
  lead        Lead?    @relation(fields: [leadId], references: [id])
  user        User     @relation(fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([assignedTo])
}

model CallLog {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  result    String
  notes     String?
  duration  Int?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
}

model PermanentCustomer {
  id                 String         @id @default(cuid())
  companyId          String
  fullName           String
  phone              String?
  phoneAlt           String?
  tripDate           DateTime?
  hotelName          String?
  tripProgramName    String?
  packageLevel       Int?
  gender             String?
  birthDate          DateTime?
  age                Int?
  jobTitle           String?
  address            String?
  governorate        String?
  tripsCount         Int            @default(1)
  idNumber           String?
  isFamily           Boolean        @default(false)
  isCancelled        Boolean        @default(false)
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  refundAmount       Float?
  branchName         String?
  source             String         @default("manual")
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  company            Company        @relation(fields: [companyId], references: [id])
  familyMembers      FamilyMember[]

  @@index([companyId])
  @@index([phone])
  @@index([isCancelled])
}

model FamilyMember {
  id         String            @id @default(cuid())
  customerId String
  name       String
  idNumber   String?
  relation   String
  birthDate  DateTime?
  createdAt  DateTime          @default(now())
  customer   PermanentCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Payment {
  id            String    @id @default(cuid())
  leadId        String
  companyId     String
  amount        Float
  method        String
  receiptNumber String?
  notes         String?
  confirmedBy   String
  isRefunded    Boolean   @default(false)
  refundedAt    DateTime?
  refundedBy    String?
  refundAmount  Float?
  refundReason  String?
  createdAt     DateTime  @default(now())
  lead          Lead      @relation(fields: [leadId], references: [id])
  company       Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([leadId])
  @@index([isRefunded])
}

model AgentInsight {
  id             String   @id @default(cuid())
  companyId      String
  conversationId String
  type           String
  category       String?
  content        String?
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([type, companyId])
}

model CompanyFAQ {
  id        String   @id @default(cuid())
  companyId String
  question  String
  answer    String
  keywords  Json?    // string[] — Arabic trigger words for code-based matching; null = no match, falls through to AI
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model HandoffLog {
  id              String   @id @default(cuid())
  companyId       String
  conversationId  String
  /// NULLABLE since Phase 3a — a BSUID-only conversation has no phone. Without this
  /// a handoff could not be recorded at all for exactly the customers we are least
  /// able to reach. Never fabricate a placeholder to fill it.
  phone           String?
  customerMessage String   @db.Text
  reason          String   // 'no_handler' | 'blocked_category' | 'output_guard' | 'repeat_failure'
  category        String?  // blocked category name when reason='blocked_category'
  blockedOutput   String?  @db.Text // AI text snippet that triggered output_guard
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([companyId, reason])
  @@index([companyId, createdAt])
}

model DailyTask {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  title       String
  description String?
  dueDate     DateTime
  dueTime     String?
  isCompleted Boolean  @default(false)
  isReminded  Boolean  @default(false)
  priority    String   @default("normal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([dueDate])
}

model SystemNotification {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
}

model Branch {
  id           String             @id @default(cuid())
  companyId    String
  name         String
  lat          Float
  lng          Float
  radiusMeters Int                @default(200)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  company      Company            @relation(fields: [companyId], references: [id])
  attendance   AttendanceRecord[]

  @@index([companyId])
}

model AttendanceRecord {
  id           String    @id @default(cuid())
  companyId    String
  userId       String
  branchId     String
  checkInAt    DateTime
  checkOutAt   DateTime?
  checkInLat   Float
  checkInLng   Float
  checkOutLat  Float?
  checkOutLng  Float?
  notes        String?
  isAutoClosed Boolean   @default(false)
  correctedBy  String?
  correctedAt  DateTime?
  createdAt    DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  branch       Branch    @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([branchId])
  @@index([checkInAt])
}

model UserSpecialtyWeight {
  id           String           @id @default(cuid())
  companyId    String
  userId       String
  specialty    ServiceSpecialty
  manualWeight Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, specialty])
  @@index([companyId])
  @@index([userId])
}

enum ActivityAction {
  CREATE
  IMPORT
  STATUS_CHANGE
  FIELD_EDIT
  NOTE_EDIT
  CLAIM
  ASSIGN
  UNASSIGN
  ARCHIVE
  UNARCHIVE
  WON
  FOLLOWUP_SET
  FOLLOWUP_CANCEL
}

model ActivityLog {
  id        String         @id @default(cuid())
  companyId String
  leadId    String
  userId    String
  userName  String
  userRole  String
  action    ActivityAction
  details   String?
  createdAt DateTime       @default(now())

  company   Company        @relation(fields: [companyId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@index([companyId, userId, createdAt])
  @@index([companyId, createdAt])
}

model SavedReply {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  title     String
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, userId])
}

model OfferingType {
  id          String     @id @default(cuid())
  companyId   String
  name        String
  icon        String?
  sortOrder   Int        @default(0)
  fieldDefs   Json
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id])
  offerings   Offering[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Offering {
  id             String       @id @default(cuid())
  companyId      String
  offeringTypeId String
  values         Json
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id])
  offeringType   OfferingType @relation(fields: [offeringTypeId], references: [id])

  @@index([companyId])
  @@index([offeringTypeId])
  @@index([companyId, offeringTypeId])
}

/// Inbound messages we could not identify, and therefore could not process.
///
/// Meta's usernames rollout omits `from`/`wa_id` once a user adopts a username.
/// Such a message cannot be answered today: this number is Cloud-API only, so
/// there is no app inbox to fall back to, and every outbound path addresses a
/// phone number we do not have.
///
/// It is recorded HERE rather than only in logs because `railway logs` covers the
/// current deployment only, and we deploy several times a day — so the one event
/// we most need to count was the one we were least able to. A lost customer must
/// be queryable a week later, not gone with the container.
///
/// NOT HandoffLog: that model's conversationId and phone are correctly required
/// for a real handoff, and these events have neither. Relaxing a NOT NULL is a
/// one-way door, and the fields that matter here (payload shape, BSUID) have no
/// column there.
///
/// PII: shape only — no message body, no profile name. waUserId is the exception
/// and is stored in FULL, because it is the recovery key: once Phase 3 can send by
/// `recipient`, this row is what makes reaching the lost customer possible.
model UnidentifiedInbound {
  id          String   @id @default(cuid())
  /// Resolved from metadata.phone_number_id when possible; null if unattributable.
  companyId   String?
  waPhoneId   String?
  /// contacts[0].user_id — the BSUID, in full. Null when Meta sent none.
  waUserId    String?
  /// message.id. Null is itself one of the reasons a message lands here.
  wamid       String?
  messageType String?
  /// Sorted key names only, never values.
  messageKeys String?
  contactKeys String?
  hasWaId     Boolean  @default(false)
  reason      String
  /// 'production' | 'test'. Set from UNIDENTIFIED_SOURCE, which only test harnesses
  /// set — production never does, so the default is the safe one.
  ///
  /// This exists because the alarm's whole value is being unambiguous. Local probes
  /// and gate suites write to the PRODUCTION database, so without this the count
  /// mixes synthetic rows with lost customers and can only be read correctly by
  /// remembering a WHERE clause. A number that needs a remembered filter will
  /// eventually be read without it — and reported as an outage that never happened.
  source      String   @default("production")
  createdAt   DateTime @default(now())

  /// Meta redelivers webhooks. Unique among NON-NULL wamids — Postgres treats
  /// NULLs as distinct, so this dedups what it can without blocking the rows whose
  /// missing id is the whole problem.
  @@unique([wamid])
  @@index([companyId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
}

/// Meta media IDs, cached so a brochure sent to fifty customers is uploaded ONCE.
///
/// Meta stores an uploaded asset for 30 days and lets it be re-sent by id, so
/// re-uploading per recipient wastes bandwidth and latency for no benefit. The key
/// is the file's sha256, so the same brochure re-picked from a rep's disk hits the
/// cache even though it is a different File object.
///
/// SCOPED PER COMPANY, never shared. A media id belongs to the WhatsApp phone
/// number that uploaded it, and sharing one across tenants would send one company's
/// asset from another company's number. Same rule as the offering-images cache.
model MediaAsset {
  id         String   @id @default(cuid())
  companyId  String
  /// sha256 of the file bytes.
  checksum   String
  /// The Meta media id, valid 30 days from upload.
  mediaId    String
  /// The phone number that uploaded it. A media id is scoped to this; if the
  /// company's number changes, the cached id is useless and must be re-uploaded.
  waPhoneId  String
  mime       String
  bytes      Int
  /// Set to 25 days after upload, short of Meta's 30, so a send never races expiry.
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([companyId, checksum])
  @@index([companyId, expiresAt])
}

/// A sales rep's PERSONAL image library — private to her, managed by her.
///
/// Deliberately carries no safety machinery: no offering link, no price
/// fingerprint, no staleness check. The rep chose the picture and the rep owns
/// whether it is right. That is the opposite of the admin offering images, which
/// the agent may send unattended and which therefore keep the full fingerprint
/// guard — see Offering.values images + Stage 2.
///
/// THE AGENT MUST NEVER READ THIS TABLE. It exists so a human can send a picture
/// she vouches for; nothing here has been checked against live prices, so an
/// unattended sender has no basis to trust it.
///
/// STORAGE IS CONTENT-ADDRESSED: the object lives at library/{companyId}/{checksum}
/// so identical bytes physically cannot duplicate. Rows are per-rep, the object is
/// per-company, and the object is removed only when the last row referencing that
/// checksum is deleted.
model LibraryImage {
  id         String   @id @default(cuid())
  companyId  String
  /// Owner. Scoped from the session — never from a query parameter.
  userId     String
  /// sha256 of the bytes; also the storage filename, which is what makes the
  /// deduplication structural rather than a process that can drift.
  checksum   String
  /// Path within the library bucket. The public URL is derived, never stored, so
  /// the two cannot disagree.
  path       String
  mime       String
  bytes      Int
  /// Shipped unwritten in v1: no shared tab yet. Present so enabling one later is
  /// a UI change rather than a migration on a table that is by then large.
  isShared   Boolean  @default(false)
  createdAt  DateTime @default(now())

  /// Re-adding a file she already has is idempotent, not an error.
  @@unique([companyId, userId, checksum])
  @@index([companyId, userId])
  /// Refcount on delete: is any other row still using this object?
  @@index([companyId, checksum])
}

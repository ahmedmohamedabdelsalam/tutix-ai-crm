generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                String         @id @default(cuid())
  name              String
  ownerName         String?
  ownerPhone        String?
  phone             String?
  waPhoneId         String?
  waToken           String?
  packages          String?
  aiPrompt          String?
  apiKey            String?        @unique
  emailDomain       String?
  industry          Industry       @default(HAJJ_UMRAH)
  subscriptionPlan  String         @default("Basic")
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  conversations     Conversation[]
  leads             Lead[]
  users             User[]
  tasks             Task[]
  permanentCustomers PermanentCustomer[]
  payments          Payment[]
  agentInsights     AgentInsight[]
  faqs              CompanyFAQ[]
  notifications     SystemNotification[]
  dailyTasks        DailyTask[]
  aiConfig          CompanyAIConfig?
  branches          Branch[]
  attendanceRecords AttendanceRecord[]
  specialtyWeights  UserSpecialtyWeight[]
}

model CompanyAIConfig {
  id               String   @id @default(cuid())
  companyId        String   @unique
  industryType     String   // "HAJJ_UMRAH" | "EDUCATION" | etc.

  // Structured catalog data (replaces hardcoded .ts files)
  // Shape: { umrahPrograms: UmrahProgram[], hajjPrograms: HajjProgram[], hotelBookingLinks: Record<string,string> }
  catalog          Json

  // Company-specific tone / personality notes (supplements base-personality.ts)
  salesPersonality String   @db.Text

  // Industry-specific structured data: branches, hotel details, Hijri dates, FAQ text, etc.
  industryData     Json?

  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  email         String   @unique
  password      String
  role                UserRole @default(AGENT)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  manualLeadWeight    Int      @default(0)
  aiLeadWeight        Int      @default(0)
  company       Company  @relation(fields: [companyId], references: [id])
  assignedLeads Lead[]   @relation("LeadAssignment")
  tasks         Task[]
  callLogs          CallLog[]
  attendanceRecords AttendanceRecord[]
  specialtyWeights  UserSpecialtyWeight[]

  @@index([companyId])
}

model Lead {
  id            String         @id @default(cuid())
  companyId     String
  name          String?
  phone         String
  packageType   String?
  groupSize     Int?
  budget        String?
  travelDate    String?
  notes         String?
  score                Int            @default(0)
  isHot                Boolean        @default(false)
  manualReviewRequired Boolean        @default(false)
  status        LeadStatus     @default(NEW)
  source        String         @default("whatsapp")
  platform      String?
  serviceType   String?
  roomType      String?
  level         String?
  governorate   String?
  recordDate    DateTime?
  totalMessages Int?
  hajjMessages  Int?
  umrahMessages Int?
  otherMessages Int?
  assignedAgent String?
  executionNotes String?
  extraNotes    String?
  companionNote String?
  referralData  Json?
  customerType  String?
  assignedTo    String?
  assignedAt    DateTime?
  tripDepartureDate  DateTime?
  tripProgramName    String?
  branchName         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  tasks         Task[]
  callLogs      CallLog[]
  payments      Payment[]
  company       Company        @relation(fields: [companyId], references: [id])
  assignedUser  User?          @relation("LeadAssignment", fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([phone])
  @@index([assignedTo])
}

model Conversation {
  id                   String         @id @default(cuid())
  companyId            String
  leadId               String?
  phone                String
  status               ConvStatus     @default(AI_HANDLING)
  agentMode            String         @default("AI")
  assignedSalesId      String?
  agentNotes           String?
  followUpScheduledAt  DateTime?
  followUpStatus       FollowUpStatus @default(NONE)
  handoffMessageSent   Boolean        @default(false)
  dropOffAnalyzed      Boolean        @default(false)
  needsSalesContact    Boolean        @default(false)
  salesAlertReason     String?
  bookingStage         String         @default("NONE")
  handledByUserId      String?
  handledByName        String?
  handledAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  company    Company    @relation(fields: [companyId], references: [id])
  lead       Lead?      @relation(fields: [leadId], references: [id])
  messages   Message[]

  @@index([companyId])
  @@index([phone, companyId])
  @@index([followUpStatus])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  senderUserId   String?
  senderName     String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

enum Industry {
  HAJJ_UMRAH
  HEALTHCARE
  REAL_ESTATE
  EDUCATION
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  SALES_MANAGER
  AGENT
  ACCOUNTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  PENDING_PAYMENT
  WON
  HOT
  CONVERTED
  COLD
  LOST
}

enum ConvStatus {
  AI_HANDLING
  NEEDS_HUMAN
  ASSIGNED
  CLOSED
}

enum FollowUpStatus {
  NONE
  SCHEDULED
  SENT
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ServiceSpecialty {
  HAJJ
  UMRAH
  FLIGHTS
  OTHER
}

model Task {
  id          String   @id @default(cuid())
  companyId   String
  leadId      String?
  assignedTo  String
  title       String
  notes       String?
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])
  lead        Lead?    @relation(fields: [leadId], references: [id])
  user        User     @relation(fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([assignedTo])
}

model CallLog {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  result    String
  notes     String?
  duration  Int?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
}

model PermanentCustomer {
  id                 String         @id @default(cuid())
  companyId          String
  fullName           String
  phone              String?
  phoneAlt           String?
  tripDate           DateTime?
  hotelName          String?
  tripProgramName    String?
  packageLevel       Int?
  gender             String?
  birthDate          DateTime?
  age                Int?
  jobTitle           String?
  address            String?
  governorate        String?
  tripsCount         Int            @default(1)
  idNumber           String?
  isFamily           Boolean        @default(false)
  isCancelled        Boolean        @default(false)
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  refundAmount       Float?
  branchName         String?
  source             String         @default("manual")
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  company            Company        @relation(fields: [companyId], references: [id])
  familyMembers      FamilyMember[]

  @@index([companyId])
  @@index([phone])
  @@index([isCancelled])
}

model FamilyMember {
  id         String            @id @default(cuid())
  customerId String
  name       String
  idNumber   String?
  relation   String
  birthDate  DateTime?
  createdAt  DateTime          @default(now())
  customer   PermanentCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Payment {
  id            String    @id @default(cuid())
  leadId        String
  companyId     String
  amount        Float
  method        String
  receiptNumber String?
  notes         String?
  confirmedBy   String
  isRefunded    Boolean   @default(false)
  refundedAt    DateTime?
  refundedBy    String?
  refundAmount  Float?
  refundReason  String?
  createdAt     DateTime  @default(now())
  lead          Lead      @relation(fields: [leadId], references: [id])
  company       Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([leadId])
  @@index([isRefunded])
}

model AgentInsight {
  id             String   @id @default(cuid())
  companyId      String
  conversationId String
  type           String
  category       String?
  content        String?
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([type, companyId])
}

model CompanyFAQ {
  id        String   @id @default(cuid())
  companyId String
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model DailyTask {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  title       String
  description String?
  dueDate     DateTime
  dueTime     String?
  isCompleted Boolean  @default(false)
  isReminded  Boolean  @default(false)
  priority    String   @default("normal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([dueDate])
}

model SystemNotification {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
}

model Branch {
  id           String             @id @default(cuid())
  companyId    String
  name         String
  lat          Float
  lng          Float
  radiusMeters Int                @default(200)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  company      Company            @relation(fields: [companyId], references: [id])
  attendance   AttendanceRecord[]

  @@index([companyId])
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  branchId    String
  checkInAt   DateTime
  checkOutAt  DateTime?
  checkInLat  Float
  checkInLng  Float
  checkOutLat Float?
  checkOutLng Float?
  notes       String?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([branchId])
  @@index([checkInAt])
}

model UserSpecialtyWeight {
  id           String           @id @default(cuid())
  companyId    String
  userId       String
  specialty    ServiceSpecialty
  manualWeight Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, specialty])
  @@index([companyId])
  @@index([userId])
}

